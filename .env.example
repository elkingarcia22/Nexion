# =============================================================================
# NEXIÓN — Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local or any file with real secrets to the repository.
# =============================================================================

# -----------------------------------------------------------------------------
# SUPABASE
# Required from: Release 1 (auth + database)
# Source: Supabase project dashboard → Settings → API
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_REF=

# Only needed if running migrations via CLI locally
# SUPABASE_ACCESS_TOKEN=

# -----------------------------------------------------------------------------
# GOOGLE OAUTH
# Required from: Release 1 (login with Google)
# Source: Google Cloud Console → APIs & Services → Credentials
# Status: pending_creation
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Redirect URL for Supabase Auth (match exactly in Google Console)
# Example: https://your-project.supabase.co/auth/v1/callback
SUPABASE_AUTH_REDIRECT_URL=

# -----------------------------------------------------------------------------
# GEMINI AI
# Required from: Release 1 (source analysis)
# Source: Google AI Studio → API Keys
# Status: pending_creation
# -----------------------------------------------------------------------------
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-1.5-flash

# -----------------------------------------------------------------------------
# SLACK
# Required from: Release 2 (Slack integration)
# Source: Slack API → Install App → Bot User OAuth Token
# Status: available
# ⚠️ SECURITY: Get real token from Slack app settings, never commit real values
# -----------------------------------------------------------------------------
# Optional fallbacks: the bot token is normally saved in Configuración → Slack bot (app_secrets).
# Needs chat:write plus the read scopes, and the bot must be in each newsletter's channel.
# NEXT_PUBLIC_SLACK_BOT_TOKEN is legacy (exposed to the browser); prefer SLACK_BOT_TOKEN.
SLACK_BOT_TOKEN=
NEXT_PUBLIC_SLACK_BOT_TOKEN=

# -----------------------------------------------------------------------------
# ANTHROPIC (Claude)
# Used by: Boletines (/api/cron/newsletters) to write the Slack pills
# Optional fallback: normally saved in Configuración → Claude AI (app_secrets).
# Source: console.anthropic.com → API Keys
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=

# -----------------------------------------------------------------------------
# N8N CLOUD
# Required from: Release 1 (automation orchestration)
# Source: n8n Cloud → Settings → API Keys
# Status: available (keep key private, rotate if exposed)
# -----------------------------------------------------------------------------
N8N_BASE_URL=https://egarcia.app.n8n.cloud
N8N_API_KEY=<get-from-n8n-settings>
N8N_MCP_SERVER_URL=https://egarcia.app.n8n.cloud/mcp-server/http
N8N_MCP_ACCESS_TOKEN=<get-from-n8n-mcp-setup>

# -----------------------------------------------------------------------------
# CRON (daily automatic analysis)
# Used by: /api/cron/daily-analysis (triggered by n8n or Vercel Cron)
# Set a random secret and use as x-api-key header when calling the endpoint.
# Also used by /api/cron/newsletters: Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>".
# -----------------------------------------------------------------------------
CRON_SECRET=

# -----------------------------------------------------------------------------
# APP
# Required from: Release 1
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# GOOGLE APIs (Google Drive, Docs, Sheets, Calendar)
# Required from: Release 3+ (integrations)
# Source: Same Google Cloud project as OAuth — additional scopes
# Status: planned / pending_setup
# -----------------------------------------------------------------------------
# GOOGLE_DRIVE_SCOPE=https://www.googleapis.com/auth/drive.readonly
# GOOGLE_DOCS_SCOPE=https://www.googleapis.com/auth/documents.readonly
# GOOGLE_SHEETS_SCOPE=https://www.googleapis.com/auth/spreadsheets.readonly
# GOOGLE_CALENDAR_SCOPE=https://www.googleapis.com/auth/calendar.readonly

# Sheet ID for OKRs/KRs sync (Release 3)
# GOOGLE_OKR_SHEET_ID=

# -----------------------------------------------------------------------------
# VERCEL (set in Vercel dashboard, not in local .env)
# Required from: Release 1 deployment
# Status: pending_creation
# -----------------------------------------------------------------------------
# VERCEL_URL — auto-injected by Vercel, do not set manually
# VERCEL_ENV — auto-injected (production | preview | development)

# -----------------------------------------------------------------------------
# SLACK (optional / future)
# Required from: Release 5+ if activated
# Status: not_needed_yet
# -----------------------------------------------------------------------------
# SLACK_WEBHOOK_URL=

# -----------------------------------------------------------------------------
# GOOGLE OAUTH CLIENT (Drive / Calendar / Sheets token refresh)
# Optional fallback: normally saved in Configuración → Google (app_secrets).
# -----------------------------------------------------------------------------
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# REQUIRED IN VERCEL (cannot live in Configuración: the app needs them to reach Supabase)
#   NEXT_PUBLIC_SUPABASE_URL, NEXT_PUBLIC_SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY, CRON_SECRET
# -----------------------------------------------------------------------------
